# ==== 主密钥（只存在于本机，只有 server.mjs 能读取）====
# Xmax 主 Key（uk- 开头），用于签发临时密钥
XMAX_API_KEY=uk-xxxxxxxxxxxxxxxxxxxx
# Xmax 临时密钥的积分上限（预算护栏，默认 500 积分）
XMAX_KEY_POINTS_LIMIT=500
# Xmax 临时密钥有效期（秒）
XMAX_KEY_EXPIRE_SECONDS=1800

# Decart 主 Key（dct_ 开头），用于签发 10 分钟 client token
DECART_API_KEY=dct_xxxxxxxxxxxxxxxxxxxx

# ==== 测试配置 ====
PORT=4400
# 每 provider 实时测试时长（毫秒），默认 180000 = 3 分钟
TEST_DURATION_MS=180000
# 测试素材文件名（放在 assets/ 目录下）
TEST_VIDEO=test-clip.mp4
TEST_GARMENT=garment.jpg
